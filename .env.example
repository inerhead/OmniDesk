# Copia este archivo a .env:  cp .env.example .env

# --- Postgres (docker compose) ---
POSTGRES_USER=omnidesk
POSTGRES_PASSWORD=omnidesk
POSTGRES_DB=omnidesk
POSTGRES_HOST_PORT=5532

# --- Subruta de la app (como en el VPS: https://<dominio>/omnidesk) ---
# Sin barra final. La usan el build de la web (base de Vite) y el API (ruta de la cookie).
BASE_PATH=/omnidesk
PUBLIC_BASE_PATH=/omnidesk

# --- Puertos del host (cámbialos si ya están ocupados) ---
API_HOST_PORT=5001
GATEWAY_HOST_PORT=8080

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=5001
# "postgres" es el hostname del servicio dentro de Docker Compose.
DATABASE_URL=postgresql://omnidesk:omnidesk@postgres:5432/omnidesk
LOG_LEVEL=info
# Tenant demo con datos de ejemplo y login de desarrollo ("Entrar como…"). Prohibido con NODE_ENV=production.
DEMO_MODE=true
# API key del canal demo (mínimo 24 caracteres). La usa el simulador como credencial.
DEMO_CHANNEL_API_KEY=dev-demo-channel-key-change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Mensajería saliente. Hoy solo existe el adaptador simulado.
MESSAGING_PROVIDER=simulated
# Probabilidad (0 a 1) de que el proveedor simulado falle un envío. 1 = falla siempre (prueba el reintento).
SIMULATED_PROVIDER_FAILURE_RATE=0
# Base de la web, con la subruta: enlaces de invitación y redirecciones tras el login (usa tu GATEWAY_HOST_PORT).
APP_URL=http://localhost:8080/omnidesk
# Proxies delante del API: 1 en local (Caddy), 2 en el VPS (Nginx + Caddy).
TRUST_PROXY=1
# Cookie de sesión solo por HTTPS. Obligatorio true en producción.
SESSION_COOKIE_SECURE=false
# Login con Google (opcional en local, obligatorio en producción). Ver README → Login con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/omnidesk/api/v1/auth/google/callback

# --- Web (apps/web) ---
# Vacía = mismo origen: el navegador llama a /omnidesk/api/... a través de Caddy (también en el VPS).
# Solo para un API en otro origen: URL absoluta, p. ej. https://api.example.com
VITE_API_URL=

# --- Gateway (caddy) ---
# web:5173 = Vite dev con HMR. Para probar la PWA: web-preview:4173 (profile pwa).
WEB_UPSTREAM=web:5173
