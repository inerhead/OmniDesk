// Modelo de la bandeja de conversaciones (SPEC 02), tiempo real (SPEC 03), asignación (SPEC 04),
// atención humana (SPEC 05) e identidad (SPEC 07).
// Todas las tablas de negocio llevan tenant_id: el tenant se resuelve siempre en el servidor.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  WHATSAPP
}

enum ChannelProvider {
  /// Adaptador simulado (canal demo, desarrollo).
  SIMULATED
  N8N
  WHATSAPP_CLOUD
  /// Se conserva, sin adaptador todavía.
  CUSTOM
}

/// Revisión de la plataforma (SPEC 18). Una empresa rechazada se borra: no hay `REJECTED`.
enum TenantApproval {
  PENDING
  APPROVED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum SenderType {
  CUSTOMER
  AI
  AGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum ConversationEventType {
  ASSIGNED
  RELEASED
  CLOSED
  REOPENED
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
}

enum AttachmentStatus {
  /// Entrante aún sin descargar de WhatsApp.
  PENDING
  READY
  FAILED
}

model Tenant {
  id                    String         @id @default(uuid(7)) @db.Uuid
  slug                  String         @unique
  name                  String
  /// Clave del logo en el bucket (SPEC 16); null sin logo.
  logoKey               String?        @map("logo_key")
  /// Versiona la URL del logo para la caché.
  logoUpdatedAt         DateTime?      @map("logo_updated_at") @db.Timestamptz(3)
  /// null = activa (SPEC 16).
  deactivatedAt         DateTime?      @map("deactivated_at") @db.Timestamptz(3)
  deactivatedByMemberId String?        @map("deactivated_by_member_id") @db.Uuid
  /// Días que se conservan las conversaciones cerradas (SPEC 12): null = indefinidamente; si no, 90 | 180 | 365.
  retentionDays         Int?           @map("retention_days")
  /// PENDING hasta que la plataforma la aprueba (SPEC 18).
  approval              TenantApproval @default(PENDING)
  approvedAt            DateTime?      @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?        @map("approved_by_user_id") @db.Uuid
  /// null = no suspendida (SPEC 18).
  suspendedAt           DateTime?      @map("suspended_at") @db.Timestamptz(3)
  suspendedByUserId     String?        @map("suspended_by_user_id") @db.Uuid
  suspensionReason      String?        @map("suspension_reason")
  /// Móvil E.164 del solicitante; null en empresas anteriores a SPEC 18.
  contactPhone          String?        @map("contact_phone")
  /// Email de login del solicitante al pedir el alta; null en empresas anteriores a SPEC 18.
  contactEmail          String?        @map("contact_email")
  /// Borrado pedido por la plataforma (SPEC 20); null = no se está borrando.
  deletionRequestedAt   DateTime?      @map("deletion_requested_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  deactivatedBy TenantMember? @relation("TenantDeactivatedBy", fields: [deactivatedByMemberId], references: [id], onDelete: Restrict)
  approvedBy    User?         @relation("TenantApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  suspendedBy   User?         @relation("TenantSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)

  channels      Channel[]
  credentials   IntegrationCredential[]
  contacts      Contact[]
  identities    ContactIdentity[]
  conversations Conversation[]
  messages      Message[]
  attachments   MessageAttachment[]
  members       TenantMember[]
  events        ConversationEvent[]
  invitations   Invitation[]

  @@map("tenants")
}

model Channel {
  id                      String          @id @default(uuid(7)) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  name                    String
  type                    ChannelType
  provider                ChannelProvider
  /// Id del número en el proveedor (phone_number_id de Meta).
  externalId              String          @map("external_id")
  /// Número público en E.164, para mostrar.
  phoneNumber             String?         @map("phone_number")
  webhookUrl              String?         @map("webhook_url")
  aiEnabled               Boolean         @default(false) @map("ai_enabled")
  whatsappAccessTokenEnc  Bytes?          @map("whatsapp_access_token_enc")
  whatsappAppSecretEnc    Bytes?          @map("whatsapp_app_secret_enc")
  whatsappVerifyTokenHash String?         @map("whatsapp_verify_token_hash")
  /// AES-256-GCM: iv (12 B) || ciphertext || tag (16 B).
  hmacSecretEnc           Bytes?          @map("hmac_secret_enc")
  hmacSecretPrevEnc       Bytes?          @map("hmac_secret_prev_enc")
  hmacSecretPrevUntil     DateTime?       @map("hmac_secret_prev_until") @db.Timestamptz(3)
  credentialsRotatedAt    DateTime?       @map("credentials_rotated_at") @db.Timestamptz(3)
  /// AES-256-GCM: iv (12 B) || ciphertext || tag (16 B). Se envía en `X-Client-Secret`; `X-Client-Id` es `id` (SPEC 22).
  n8nClientSecretEnc      Bytes?          @map("n8n_client_secret_enc")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  credentials   IntegrationCredential[]
  identities    ContactIdentity[]
  conversations Conversation[]
  messages      Message[]

  @@unique([tenantId, externalId])
  @@map("channels")
}

model IntegrationCredential {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  /// sha256 hex de la API key; la key nunca se guarda en claro.
  keyHash   String    @unique @map("key_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Fin de la vigencia tras una rotación; null = vigente indefinidamente.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@map("integration_credentials")
}

model Contact {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  identities    ContactIdentity[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  contactId  String @map("contact_id") @db.Uuid
  channelId  String @map("channel_id") @db.Uuid
  /// Teléfono E.164, p. ej. "+573001234567".
  externalId String @map("external_id")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([channelId, externalId])
  @@map("contact_identities")
}

model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  channelId          String             @map("channel_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  assignedAgentId    String?            @map("assigned_agent_id") @db.Uuid
  controlVersion     Int                @default(0) @map("control_version")
  lastSequence       Int                @default(0) @map("last_sequence")
  lastMessageAt      DateTime           @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String             @map("last_message_preview")
  /// Último mensaje entrante del cliente: abre la ventana de respuesta de 18 h.
  lastInboundAt      DateTime?          @map("last_inbound_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  channel       Channel             @relation(fields: [channelId], references: [id])
  contact       Contact             @relation(fields: [contactId], references: [id])
  messages      Message[]
  events        ConversationEvent[]
  assignedAgent TenantMember?       @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)

  /// Una sola conversación abierta por contacto y canal.
  @@unique([channelId, contactId], map: "conversations_one_open_per_contact", where: raw("status = 'OPEN'"))
  @@index([tenantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  channelId         String           @map("channel_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  sequence          Int
  direction         MessageDirection
  senderType        SenderType       @map("sender_type")
  text              String
  status            MessageStatus
  /// Id del proveedor: en los entrantes, el del mensaje; en los salientes, el `providerMessageId`.
  externalId        String?          @map("external_id")
  /// Clave de idempotencia (respuestas de IA).
  idempotencyKey    String?          @map("idempotency_key")
  providerTimestamp DateTime?        @map("provider_timestamp") @db.Timestamptz(3)
  /// Agente que escribió el mensaje (solo AGENT).
  senderMemberId    String?          @map("sender_member_id") @db.Uuid
  /// Idempotencia del composer de la web.
  clientMessageId   String?          @map("client_message_id")
  failureReason     String?          @map("failure_reason")
  statusUpdatedAt   DateTime?        @map("status_updated_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  channel      Channel            @relation(fields: [channelId], references: [id])
  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       TenantMember?      @relation(fields: [senderMemberId], references: [id], onDelete: Restrict)
  attachment   MessageAttachment?

  @@unique([conversationId, sequence])
  @@unique([conversationId, clientMessageId])
  @@unique([channelId, externalId])
  @@unique([conversationId, idempotencyKey])
  @@map("messages")
}

/// Persona con cuenta (Google o demo). Sus membresías dicen a qué empresas pertenece.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// `sub` de Google; null para los usuarios demo.
  googleSub       String?   @unique @map("google_sub")
  /// Siempre en minúsculas.
  email           String    @unique
  displayName     String    @map("display_name")
  /// Foto de Google; se actualiza en cada login con Google.
  googleAvatarUrl String?   @map("avatar_url")
  /// Clave en el bucket de la foto subida (SPEC 15); null si no hay.
  avatarKey       String?   @map("avatar_key")
  /// Cuándo se subió la foto actual; versiona la URL para la caché.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships       TenantMember[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  approvedTenants   Tenant[]           @relation("TenantApprovedBy")
  suspendedTenants  Tenant[]           @relation("TenantSuspendedBy")
  tenantRejections  TenantRejection[]  @relation("TenantRejectionUser")
  rejectionsMade    TenantRejection[]  @relation("TenantRejectionBy")
  tenantDeletions   TenantDeletion[]   @relation("TenantDeletionBy")

  @@map("users")
}

/// Solicitud rechazada (SPEC 18). La empresa se borra; queda esto para el aviso y la pestaña
/// Rechazadas. Sin tenant_id ni RLS: solo la leen caminos de sistema. Se borra a los 20 días.
model TenantRejection {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tenantName       String    @map("tenant_name")
  tenantSlug       String    @map("tenant_slug")
  reason           String
  contactPhone     String?   @map("contact_phone")
  contactEmail     String?   @map("contact_email")
  requestedAt      DateTime  @map("requested_at") @db.Timestamptz(3)
  rejectedAt       DateTime  @map("rejected_at") @db.Timestamptz(3)
  rejectedByUserId String?   @map("rejected_by_user_id") @db.Uuid
  /// El solicitante cerró el aviso o envió otra solicitud.
  dismissedAt      DateTime? @map("dismissed_at") @db.Timestamptz(3)

  user       User  @relation("TenantRejectionUser", fields: [userId], references: [id], onDelete: Cascade)
  rejectedBy User? @relation("TenantRejectionBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rejectedAt])
  @@map("tenant_rejections")
}

/// Constancia de una empresa borrada (SPEC 20). Sobrevive a la empresa: `tenant_id` sin FK y sin
/// RLS. Solo la leen y escriben caminos de sistema. Se conserva indefinidamente.
model TenantDeletion {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  tenantName           String    @map("tenant_name")
  tenantSlug           String    @map("tenant_slug")
  requestedByUserId    String?   @map("requested_by_user_id") @db.Uuid
  /// Copia: se conserva aunque la cuenta del admin desaparezca.
  requestedByEmail     String    @map("requested_by_email")
  requestedAt          DateTime  @map("requested_at") @db.Timestamptz(3)
  /// null = el job aún no terminó.
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  lastError            String?   @map("last_error")
  membersDeleted       Int       @default(0) @map("members_deleted")
  usersDeleted         Int       @default(0) @map("users_deleted")
  conversationsDeleted Int       @default(0) @map("conversations_deleted")
  messagesDeleted      Int       @default(0) @map("messages_deleted")
  attachmentsDeleted   Int       @default(0) @map("attachments_deleted")
  objectsDeleted       Int       @default(0) @map("objects_deleted")

  requestedBy User? @relation("TenantDeletionBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([requestedAt])
  @@map("tenant_deletions")
}

/// Suscripción Web Push de un dispositivo. Pertenece al usuario, no a una empresa.
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Sesión de la web. La cookie lleva el token; aquí solo se guarda su sha256.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// sha256 hex del token de la cookie.
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Invitación por enlace: de un solo uso, ligada al email y con vencimiento.
model Invitation {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  /// Siempre en minúsculas.
  email       String
  /// ADMIN o AGENT: un OWNER no se invita.
  role        MemberRole
  /// sha256 hex del token del enlace.
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  invitedBy TenantMember @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("invitations")
}

model TenantMember {
  id                      String     @id @default(uuid(7)) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  displayName             String     @map("display_name")
  email                   String
  role                    MemberRole
  /// null solo en filas previas a SPEC 07 (la semilla demo las enlaza).
  userId                  String?    @map("user_id") @db.Uuid
  /// Baja lógica: el historial lo sigue referenciando.
  removedAt               DateTime?  @map("removed_at") @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  notifyAssigned          Boolean    @default(true) @map("notify_assigned")
  notifyCustomerMessage   Boolean    @default(true) @map("notify_customer_message")
  notifySendFailed        Boolean    @default(true) @map("notify_send_failed")
  notifyNewAiConversation Boolean    @default(false) @map("notify_new_ai_conversation")

  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])
  deactivatedTenants    Tenant[]            @relation("TenantDeactivatedBy")
  assignedConversations Conversation[]
  actedEvents           ConversationEvent[] @relation("EventActor")
  targetedEvents        ConversationEvent[] @relation("EventTarget")
  sentMessages          Message[]
  sentInvitations       Invitation[]

  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model ConversationEvent {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  /// Comparte el contador `lastSequence` con los mensajes: una sola línea de tiempo.
  sequence       Int
  type           ConversationEventType
  /// null = sistema (reapertura por inbound).
  actorMemberId  String?               @map("actor_member_id") @db.Uuid
  /// Agente asignado en ASSIGNED.
  targetMemberId String?               @map("target_member_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor        TenantMember? @relation("EventActor", fields: [actorMemberId], references: [id], onDelete: Restrict)
  target       TenantMember? @relation("EventTarget", fields: [targetMemberId], references: [id], onDelete: Restrict)

  @@unique([conversationId, sequence])
  @@map("conversation_events")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// "conversation.changed" (SPEC 03) o "message.send_requested" (SPEC 05).
  type          String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt], map: "outbox_events_pending", where: raw("published_at IS NULL"))
  @@index([publishedAt])
  @@map("outbox_events")
}

/// Deduplicación de reportes de integraciones (SPEC 05).
model EventInbox {
  id         String   @id @default(uuid(7)) @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  /// "<messageId>:<status>" para estados de entrega.
  externalId String   @map("external_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([channelId, externalId])
  @@map("event_inbox")
}

/// Archivo de un mensaje (SPEC 14). Los bytes viven en el bucket (`storageKey`), nunca en Postgres.
model MessageAttachment {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  messageId       String           @unique @map("message_id") @db.Uuid
  kind            AttachmentKind
  mimeType        String           @map("mime_type")
  fileName        String?          @map("file_name")
  sizeBytes       Int?             @map("size_bytes")
  /// Nota de voz grabada en WhatsApp.
  voice           Boolean          @default(false)
  /// sha256 que reporta Meta (base64 en el webhook): se verifica al descargar.
  sha256          String?
  /// Media id de Meta (entrantes): con él se descarga.
  providerMediaId String?          @map("provider_media_id")
  /// Clave del objeto en el bucket; null mientras está PENDING.
  storageKey      String?          @map("storage_key")
  status          AttachmentStatus
  failureReason   String?          @map("failure_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("message_attachments")
}

/// Constancia de un borrado (SPEC 12), sin datos personales: quién, cuándo y cuánto.
model DeletionLog {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  /// "contact" (a petición) | "retention" (job).
  kind                 String
  /// null en el job.
  actorMemberId        String?  @map("actor_member_id") @db.Uuid
  conversationsDeleted Int      @map("conversations_deleted")
  messagesDeleted      Int      @map("messages_deleted")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("deletion_log")
}
