// Modelo de la bandeja de conversaciones (SPEC 02), tiempo real (SPEC 03), asignación (SPEC 04),
// atención humana (SPEC 05) e identidad (SPEC 07).
// Todas las tablas de negocio llevan tenant_id: el tenant se resuelve siempre en el servidor.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  WHATSAPP
}

enum ChannelProvider {
  /// Adaptador simulado (canal demo, desarrollo).
  SIMULATED
  N8N
  /// Se conserva, sin adaptador todavía.
  CUSTOM
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum SenderType {
  CUSTOMER
  AI
  AGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum ConversationEventType {
  ASSIGNED
  RELEASED
  CLOSED
  REOPENED
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  channels      Channel[]
  credentials   IntegrationCredential[]
  contacts      Contact[]
  identities    ContactIdentity[]
  conversations Conversation[]
  messages      Message[]
  members       TenantMember[]
  events        ConversationEvent[]
  invitations   Invitation[]

  @@map("tenants")
}

model Channel {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String
  type       ChannelType
  provider   ChannelProvider
  /// Id del número en el proveedor (phone_number_id de Meta).
  externalId String          @map("external_id")
  /// Número público en E.164, para mostrar.
  phoneNumber          String?   @map("phone_number")
  webhookUrl           String?   @map("webhook_url")
  /// AES-256-GCM: iv (12 B) || ciphertext || tag (16 B).
  hmacSecretEnc        Bytes?    @map("hmac_secret_enc")
  hmacSecretPrevEnc    Bytes?    @map("hmac_secret_prev_enc")
  hmacSecretPrevUntil  DateTime? @map("hmac_secret_prev_until") @db.Timestamptz(3)
  credentialsRotatedAt DateTime? @map("credentials_rotated_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  credentials   IntegrationCredential[]
  identities    ContactIdentity[]
  conversations Conversation[]
  messages      Message[]

  @@unique([tenantId, externalId])
  @@map("channels")
}

model IntegrationCredential {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  /// sha256 hex de la API key; la key nunca se guarda en claro.
  keyHash   String    @unique @map("key_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Fin de la vigencia tras una rotación; null = vigente indefinidamente.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@map("integration_credentials")
}

model Contact {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  identities    ContactIdentity[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  contactId  String @map("contact_id") @db.Uuid
  channelId  String @map("channel_id") @db.Uuid
  /// Teléfono E.164, p. ej. "+573001234567".
  externalId String @map("external_id")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([channelId, externalId])
  @@map("contact_identities")
}

model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  channelId          String             @map("channel_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  assignedAgentId    String?            @map("assigned_agent_id") @db.Uuid
  controlVersion     Int                @default(0) @map("control_version")
  lastSequence       Int                @default(0) @map("last_sequence")
  lastMessageAt      DateTime           @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String             @map("last_message_preview")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  channel       Channel             @relation(fields: [channelId], references: [id])
  contact       Contact             @relation(fields: [contactId], references: [id])
  messages      Message[]
  events        ConversationEvent[]
  assignedAgent TenantMember?       @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)

  /// Una sola conversación abierta por contacto y canal.
  @@unique([channelId, contactId], map: "conversations_one_open_per_contact", where: raw("status = 'OPEN'"))
  @@index([tenantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  channelId         String           @map("channel_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  sequence          Int
  direction         MessageDirection
  senderType        SenderType       @map("sender_type")
  text              String
  status            MessageStatus
  /// Id del proveedor: en los entrantes, el del mensaje; en los salientes, el `providerMessageId`.
  externalId        String?          @map("external_id")
  /// Clave de idempotencia (respuestas de IA).
  idempotencyKey    String?          @map("idempotency_key")
  providerTimestamp DateTime?        @map("provider_timestamp") @db.Timestamptz(3)
  /// Agente que escribió el mensaje (solo AGENT).
  senderMemberId    String?          @map("sender_member_id") @db.Uuid
  /// Idempotencia del composer de la web.
  clientMessageId   String?          @map("client_message_id")
  failureReason     String?          @map("failure_reason")
  statusUpdatedAt   DateTime?        @map("status_updated_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  channel      Channel       @relation(fields: [channelId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id])
  sender       TenantMember? @relation(fields: [senderMemberId], references: [id], onDelete: Restrict)

  @@unique([conversationId, sequence])
  @@unique([conversationId, clientMessageId])
  @@unique([channelId, externalId])
  @@unique([conversationId, idempotencyKey])
  @@map("messages")
}

/// Persona con cuenta (Google o demo). Sus membresías dicen a qué empresas pertenece.
model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// `sub` de Google; null para los usuarios demo.
  googleSub   String?  @unique @map("google_sub")
  /// Siempre en minúsculas.
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships TenantMember[]
  sessions    Session[]

  @@map("users")
}

/// Sesión de la web. La cookie lleva el token; aquí solo se guarda su sha256.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// sha256 hex del token de la cookie.
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Invitación por enlace: de un solo uso, ligada al email y con vencimiento.
model Invitation {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  /// Siempre en minúsculas.
  email       String
  /// ADMIN o AGENT: un OWNER no se invita.
  role        MemberRole
  /// sha256 hex del token del enlace.
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  invitedBy TenantMember @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("invitations")
}

model TenantMember {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  displayName String     @map("display_name")
  email       String
  role        MemberRole
  /// null solo en filas previas a SPEC 07 (la semilla demo las enlaza).
  userId      String?    @map("user_id") @db.Uuid
  /// Baja lógica: el historial lo sigue referenciando.
  removedAt   DateTime?  @map("removed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])
  assignedConversations Conversation[]
  actedEvents           ConversationEvent[] @relation("EventActor")
  targetedEvents        ConversationEvent[] @relation("EventTarget")
  sentMessages          Message[]
  sentInvitations       Invitation[]

  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model ConversationEvent {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  /// Comparte el contador `lastSequence` con los mensajes: una sola línea de tiempo.
  sequence       Int
  type           ConversationEventType
  /// null = sistema (reapertura por inbound).
  actorMemberId  String?               @map("actor_member_id") @db.Uuid
  /// Agente asignado en ASSIGNED.
  targetMemberId String?               @map("target_member_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id])
  actor        TenantMember? @relation("EventActor", fields: [actorMemberId], references: [id], onDelete: Restrict)
  target       TenantMember? @relation("EventTarget", fields: [targetMemberId], references: [id], onDelete: Restrict)

  @@unique([conversationId, sequence])
  @@map("conversation_events")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// "conversation.changed" (SPEC 03) o "message.send_requested" (SPEC 05).
  type          String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt], map: "outbox_events_pending", where: raw("published_at IS NULL"))
  @@index([publishedAt])
  @@map("outbox_events")
}

/// Deduplicación de reportes de integraciones (SPEC 05).
model EventInbox {
  id         String   @id @default(uuid(7)) @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  /// "<messageId>:<status>" para estados de entrega.
  externalId String   @map("external_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([channelId, externalId])
  @@map("event_inbox")
}
