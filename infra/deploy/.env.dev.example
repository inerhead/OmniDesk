# OmniDesk — entorno dev en el VPS (proyecto Compose omnidesk-dev).
# Copia a /srv/omnidesk/.env.dev (chmod 600) y rellena los valores marcados con <…>. Nunca lo subas a git.
# Ver docs/despliegue.md.

# --- Entorno ---
# Nombre del entorno: va en el nombre de los backups (omnidesk-dev-YYYYMMDD.dump).
OMNIDESK_ENV=dev

# --- Postgres (contenedor, sin puertos publicados) ---
POSTGRES_USER=omnidesk
# Solo letras y números (va dentro de DATABASE_URL). Genera una con: openssl rand -hex 24
POSTGRES_PASSWORD=<openssl rand -hex 24>
# Rol de aplicación sin BYPASSRLS (SPEC 12). Hex: va dentro de una URL.
DATABASE_APP_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=omnidesk

# --- Subruta (comunes al API y al build de la web) ---
# Sin barra final. Nginx reenvía https://dev.gastromesa.com/omnidesk/* conservando el prefijo.
BASE_PATH=/omnidesk
PUBLIC_BASE_PATH=/omnidesk

# --- API ---
NODE_ENV=production
LOG_LEVEL=info
# Prohibido con NODE_ENV=production (SPEC 02). Dev también entra con Google, como prod.
DEMO_MODE=false
# Admins de plataforma (SPEC 18): emails de Google separados por comas. Vacío = nadie aprueba
# empresas nuevas y se quedan en revisión.
PLATFORM_ADMIN_EMAILS=<tu-email@gmail.com>
APP_URL=https://dev.gastromesa.com/omnidesk
CORS_ORIGINS=https://dev.gastromesa.com
# Nginx + Caddy delante del API: IP real, esquema https y cookie Secure.
TRUST_PROXY=2
SESSION_COOKIE_SECURE=true
# Cliente OAuth de Google de este entorno. URI de redirección autorizada = GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=<…apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<…>
GOOGLE_CALLBACK_URL=https://dev.gastromesa.com/omnidesk/api/v1/auth/google/callback
# Canales (SPEC 09). El adaptador de envío sale de cada canal (SIMULATED o N8N).
# Clave AES-256-GCM de los secretos HMAC: distinta por entorno y guardada junto a los backups
# (sin ella, los secretos son ilegibles y hay que rotar credenciales). Genera con: openssl rand -base64 32
CHANNEL_SECRETS_KEY=<openssl rand -base64 32>
# Web Push (opcional). Las tres juntas. pnpm --filter @omnidesk/api vapid:generate
# VAPID_SUBJECT=mailto:soporte@gastromesa.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Métricas (SPEC 11) ---
# Token de /api/v1/metrics (≥ 32 caracteres): openssl rand -hex 32. Vacío = endpoint deshabilitado.
# El gateway lo bloquea igual desde internet; solo se consulta desde el VPS (docs/observabilidad.md).
METRICS_TOKEN=
# Con un evento del Outbox pendiente desde hace más de esto, /health dice outbox: lagging.
# OUTBOX_LAG_THRESHOLD_SECONDS=60
# Hosts a los que se admite un webhookUrl por http:// o con IP privada; p. ej. "n8n" si n8n corre en el VPS.
N8N_WEBHOOK_ALLOWED_HOSTS=
SIMULATED_PROVIDER_FAILURE_RATE=0
# Lo rellena deploy.sh (commit corto o etiqueta); déjala vacía.
APP_VERSION=

# --- Build de la web ---
# Vacía = mismo origen: <BASE_PATH>/api.
VITE_API_URL=

# --- Compose ---
# Solo en 127.0.0.1: lo expone el Nginx del servidor.
GATEWAY_HOST_PORT=8081
BACKUP_DIR=/srv/omnidesk/backups/dev

# Versión de Graph API para WhatsApp Cloud directo.
WHATSAPP_GRAPH_VERSION=v25.0

# --- Adjuntos (SPEC 14): MinIO del proyecto ---
MINIO_ROOT_USER=omnidesk
# Solo letras y números. Genera con: openssl rand -hex 24
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
# Solo en 127.0.0.1. dev 9050, prod 9060 (no pueden coincidir en el mismo VPS).
MINIO_HOST_PORT=9050
