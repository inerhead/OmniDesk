# OmniDesk — entorno prod en el VPS (proyecto Compose omnidesk-prod).
# Copia a /srv/omnidesk/.env.prod (chmod 600) y rellena los valores marcados con <…>. Nunca lo subas a git.
# Ver docs/despliegue.md.

# --- Entorno ---
# Nombre del entorno: va en el nombre de los backups (omnidesk-prod-YYYYMMDD.dump).
OMNIDESK_ENV=prod

# --- Postgres (contenedor, sin puertos publicados) ---
POSTGRES_USER=omnidesk
# Solo letras y números (va dentro de DATABASE_URL). Genera una con: openssl rand -hex 24
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=omnidesk

# --- Subruta (comunes al API y al build de la web) ---
# Sin barra final. Nginx reenvía https://gastromesa.com/omnidesk/* conservando el prefijo.
BASE_PATH=/omnidesk
PUBLIC_BASE_PATH=/omnidesk

# --- API ---
NODE_ENV=production
LOG_LEVEL=info
# Prohibido con NODE_ENV=production (SPEC 02). Dev también entra con Google, como prod.
DEMO_MODE=false
APP_URL=https://gastromesa.com/omnidesk
CORS_ORIGINS=https://gastromesa.com
# Nginx + Caddy delante del API: IP real, esquema https y cookie Secure.
TRUST_PROXY=2
SESSION_COOKIE_SECURE=true
# Cliente OAuth de Google de este entorno. URI de redirección autorizada = GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=<…apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<…>
GOOGLE_CALLBACK_URL=https://gastromesa.com/omnidesk/api/v1/auth/google/callback
# Mensajería saliente. Hoy solo existe el adaptador simulado (n8n + WhatsApp llegan con SPEC 09).
MESSAGING_PROVIDER=simulated
SIMULATED_PROVIDER_FAILURE_RATE=0
# Lo rellena deploy.sh (commit corto o etiqueta); déjala vacía.
APP_VERSION=

# --- Build de la web ---
# Vacía = mismo origen: <BASE_PATH>/api.
VITE_API_URL=

# --- Compose ---
# Solo en 127.0.0.1: lo expone el Nginx del servidor.
GATEWAY_HOST_PORT=8082
BACKUP_DIR=/srv/omnidesk/backups/prod
