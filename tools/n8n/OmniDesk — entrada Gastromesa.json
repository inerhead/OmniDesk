    {
      "parameters": {
        "jsCode": "// Arma la entrada del agente con el historial que envía OmniDesk (SPEC 24).\nconst body = $('OmniDesk').first().json.body;\nconst ADJUNTOS = { IMAGE: 'imagen', DOCUMENT: 'documento', AUDIO: 'audio', VIDEO: 'video', STICKER: 'sticker' };\n\nfunction quien(mensaje) {\n  if (mensaje.role === 'ai') return 'Asistente';\n  if (mensaje.role === 'agent') return mensaje.agentName ? `Agente (${mensaje.agentName})` : 'Agente';\n  return 'Cliente';\n}\n\nfunction linea(mensaje) {\n  const adjunto = mensaje.attachment ? `[${ADJUNTOS[mensaje.attachment] ?? 'adjunto'}]` : '';\n  return `${quien(mensaje)}: ${[adjunto, mensaje.text].filter(Boolean).join(' ')}`;\n}\n\nconst partes = [];\nif (body.from?.displayName) partes.push(`Nombre del cliente en WhatsApp: ${body.from.displayName}`);\nconst historial = body.history ?? [];\nif (historial.length > 0) partes.push(`Conversación hasta ahora:\\n${historial.map(linea).join('\\n')}`);\npartes.push(`Mensaje actual del cliente:\\n${body.text}`);\n\nreturn [{ json: { prompt: partes.join('\\n\\n') } }];\n"
      },
