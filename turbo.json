{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "API_PORT",
    "DATABASE_URL",
    "LOG_LEVEL",
    "CORS_ORIGINS",
    "CHOKIDAR_USEPOLLING",
    "DEMO_MODE",
    "DEMO_CHANNEL_API_KEY",
    "SIMULATOR_API_URL",
    "GATEWAY_HOST_PORT",
    "APP_URL",
    "PUBLIC_BASE_PATH",
    "TRUST_PROXY",
    "GOOGLE_CALLBACK_URL",
    "APP_VERSION",
    "SIMULATED_PROVIDER_FAILURE_RATE",
    "CHANNEL_SECRETS_KEY",
    "N8N_WEBHOOK_ALLOWED_HOSTS",
    "WHATSAPP_GRAPH_VERSION",
    "SIMULATOR_HMAC_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "BASE_PATH"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["VITE_*", "BASE_PATH"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
